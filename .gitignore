# GNU Texinfo build outputs (keep source .texi/.texinfo files tracked)
/mymanual.info
/mymanual.info-*
/mymanual_html/
/multi.info
/multi.info-*
/multi_html/
/doc/*.info
/doc/*.info-*
/doc/*_html/
/doc/*.pdf
/docs/book.pdf

# TeX and texi2pdf intermediate files
*.aux
*.cp
*.cps
*.fn
*.fns
*.ky
*.kys
*.log
*.pg
*.pgs
*.tmp
*.toc
*.tp
*.tps
*.vr
*.vrs

# Terraform working directories and generated state
**/.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log
*.tfplan
*.tfplan.*

# Terraform variable files may contain credentials or environment-specific values.
# Keep explicitly named examples trackable.
*.tfvars
*.tfvars.json
!*.example.tfvars
!*.example.tfvars.json

# Generated Lambda deployment archive
/modules/lmlmxtend-runtime/reaper/index.zip

# Python caches and test/coverage output
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# Local environment and editor files
.env
.env.*
!.env.example
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# Generated PDFs and legacy manual outputs
/mymanual.pdf
/multi.pdf
/my-manual/mymanual-legacy.info
/my-manual/mymanual-legacy.info-*
/my-manual/mymanual-legacy_html/
/my-manual/mymanual-legacy.pdf
